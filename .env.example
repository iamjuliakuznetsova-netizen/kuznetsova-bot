# Токен бота, выданный @BotFather в Telegram
BOT_TOKEN=

# Канал, подписку на который проверяет бот (общий для всех сценариев)
MAIN_CHANNEL=@semero4ka_videomaker

# Ссылка на Клод-клуб (используется в приглашении после выдачи гайда)
KLOD_KLUB_URL=https://kuznetsova.studio/klaudeklub

# Ссылка на гайд «10 промтов для упаковки аккаунта» (Тильда).
# ВАЖНО: это плейсхолдер, перед запуском в прод заменить на реальную ссылку.
UPAKOVKA_GUIDE_URL=https://example.tilda.ws/upakovka

# Ссылка на гайд «Как подключить домен».
# ВАЖНО: это плейсхолдер, перед запуском в прод заменить на реальную ссылку.
DOMEN_GUIDE_URL=https://example.tilda.ws/domen

# Ссылка на гайд «7 поручений для ChatGPT Work».
GPTWORK_GUIDE_URL=https://kuznetsova.studio/gptwork

# Ссылка на пост с шрифтами в канале
SHRIFTY_POST_URL=https://t.me/semero4ka_videomaker/3099

# Ссылка на пост-библиотеку уроков по Telegram в канале
TG_UROKI_POST_URL=https://t.me/semero4ka_videomaker/3862

# Путь к файлу базы данных SQLite (можно не менять)
DB_PATH=bot.db

# telegram_id через запятую, для которых гайд и приглашение в Клод-клуб
# отправляются при каждом заходе, а не один раз - удобно для тестирования
TEST_TELEGRAM_IDS=

# telegram_id через запятую, у кого есть доступ к админским командам бота
# (/stats - статистика, /broadcast - рассылка всем пользователям)
ADMIN_TELEGRAM_IDS=
